@page "/"

<PageTitle>五子棋</PageTitle>

<h1>五子棋游戏</h1>

<div style="margin-bottom:10px;">
    <span style="width:200px;">当前玩家: <b>@(currentPlayer == 1 ? "黑子" : (isHumanVsAI ? "白子" : "白子"))</b></span>
    @if (winner != 0)
    {
        <span style="color:red;margin-left:20px;">胜者: @(winner == 1 ? "黑子" : (isHumanVsAI ? "白子" : "白子"))</span>
        <button class="btn btn-sm btn-primary" style="margin-left:20px;" @onclick="Restart">重新开始</button>
    }
</div>

<div style="margin-bottom:10px;">
    <b>难度：</b>
    <button class="btn btn-sm @(aiLevel==0?"btn-primary":"btn-outline-primary")" @onclick="() => SetAILevel(0)">简单</button>
    <button class="btn btn-sm @(aiLevel==1?"btn-primary":"btn-outline-primary")" @onclick="() => SetAILevel(1)">中等</button>
    <button class="btn btn-sm @(aiLevel==2?"btn-primary":"btn-outline-primary")" @onclick="() => SetAILevel(2)">困难</button>
    <span style="margin-left:20px;">
        <b>模式：</b>
        <button class="btn btn-sm @(isHumanVsAI?"btn-success":"btn-outline-success")" @onclick="ToggleMode">
            @(isHumanVsAI ? "人机对战" : "人人对战")
        </button>
    </span>
</div>


<div style="margin-bottom:10px;">
    <span>黑子得分: <b>@blackScore</b></span>
    <span style="margin-left:20px;">白子得分: <b>@whiteScore</b></span>
    <button class="btn btn-sm btn-danger" style="margin-left:20px;" @onclick="ResetScore">重置得分</button>
    <button class="btn btn-sm btn-warning" @onclick="Undo" disabled="@(moveHistory.Count == 0)">悔棋</button>
</div>

<table style="border-collapse:collapse;">
    @for (int y = 0; y < BoardSize; y++)
    {
        <tr>
            @for (int x = 0; x < BoardSize; x++)
            {
                int _x = x;
                int _y = y;
                <td class="cell @(lastMoveX == x && lastMoveY == y ? "last-move" : "")" style="width:32px;height:32px;border:1px solid #888;text-align:center;vertical-align:middle;cursor:pointer;background:@GetCellBg(x, y);padding:0;">
                    <span style="display:inline-block;width:100%;height:100%;line-height:32px;font-size:24px;user-select:none;"
                          @onclick="@(() => PlacePiece(_x, _y))">
                        @if (board[x, y] == 1)
                        {
                            <span style="color:black;">●</span>
                        }
                        else if (board[x, y] == 2)
                        {
                            <span style="color:#eee;text-shadow:0 0 2px #888;">●</span>
                        }
                        else
                        {
                            <span style="visibility:hidden;">●</span>
                        }
                    </span>
                </td>
            }
        </tr>
    }
</table>

@code {
    const int BoardSize = 12;
    int[,] board = new int[BoardSize, BoardSize];
    int currentPlayer = 1; // 1: 黑子, 2: 白子(电脑/玩家)
    int winner = 0;
    int blackScore = 0;
    int whiteScore = 0;
    Random rand = new();
    bool isHumanVsAI = true;
    int aiLevel = 1; // 0:简单 1:中等 2:困难
    // 记录每一步
    record Move(int X, int Y, int Player, int[,] BoardSnapshot, int CurrentPlayer, int Winner);

    List<Move> moveHistory = new();
    int? lastMoveX = null;
    int? lastMoveY = null;

    void PlacePiece(int x, int y)
    {
        if (winner != 0 || board[x, y] != 0)
            return;
        if (isHumanVsAI && currentPlayer == 2)
            return;

        moveHistory.Add(new Move(x, y, currentPlayer, (int[,])board.Clone(), currentPlayer, winner));

        board[x, y] = currentPlayer;
        lastMoveX = x; // 记录最新落子
        lastMoveY = y;
        if (CheckWin(x, y, currentPlayer))
        {
            winner = currentPlayer;
            if (winner == 1)
                blackScore++;
            else if (winner == 2)
                whiteScore++;
        }
        else
        {
            currentPlayer = 3 - currentPlayer;
            if (isHumanVsAI && currentPlayer == 2 && winner == 0)
            {
                StateHasChanged();
                _ = AITurnAsync();
            }
        }
    }

    async Task AITurnAsync()
    {
        await Task.Delay(500);
        if (winner != 0) return;

        var (aiX, aiY) = FindBestMove();
        moveHistory.Add(new Move(aiX, aiY, 2, (int[,])board.Clone(), currentPlayer, winner));

        board[aiX, aiY] = 2;
        lastMoveX = aiX; // 记录AI最新落子
        lastMoveY = aiY;
        if (CheckWin(aiX, aiY, 2))
        {
            winner = 2;
            whiteScore++;
        }
        else
        {
            currentPlayer = 1;
        }
        StateHasChanged();
    }

    (int, int) FindBestMove()
    {
        if (aiLevel == 0)
        {
            // 简单：随机落子
            var empty = new List<(int x, int y)>();
            for (int i = 0; i < BoardSize; i++)
                for (int j = 0; j < BoardSize; j++)
                    if (board[i, j] == 0)
                        empty.Add((i, j));
            return empty[rand.Next(empty.Count)];
        }
        else
        {
            // 中等/困难：评分法
            int maxScore = int.MinValue;
            var bestMoves = new List<(int x, int y)>();
            for (int x = 0; x < BoardSize; x++)
            {
                for (int y = 0; y < BoardSize; y++)
                {
                    if (board[x, y] != 0) continue;
                    int score = EvaluatePoint(x, y, 2);
                    score = Math.Max(score, EvaluatePoint(x, y, 1));
                    if (score > maxScore)
                    {
                        maxScore = score;
                        bestMoves.Clear();
                        bestMoves.Add((x, y));
                    }
                    else if (score == maxScore)
                    {
                        bestMoves.Add((x, y));
                    }
                }
            }
            return bestMoves[rand.Next(bestMoves.Count)];
        }
    }

    int EvaluatePoint(int x, int y, int player)
    {
        int score = 0;
        int opponent = player == 1 ? 2 : 1;
        // 不同难度权重
        int[] winWeight = { 100, 10000, 10000 };
        int[] fourWeight = { 10, 1000, 3000 };
        int[] threeWeight = { 5, 100, 500 };
        int[] twoWeight = { 2, 10, 50 };
        int[] blockWinWeight = { 90, 9000, 9000 };
        int[] blockFourWeight = { 9, 900, 2500 };
        int[] blockThreeWeight = { 4, 90, 400 };
        int[] blockTwoWeight = { 1, 9, 40 };

        foreach (var dir in new[] { (1, 0), (0, 1), (1, 1), (1, -1) })
        {
            int count = 1 + CountDirection(x, y, dir.Item1, dir.Item2, player)
                          + CountDirection(x, y, -dir.Item1, -dir.Item2, player);
            if (count >= 5) score += winWeight[aiLevel];
            else if (count == 4) score += fourWeight[aiLevel];
            else if (count == 3) score += threeWeight[aiLevel];
            else if (count == 2) score += twoWeight[aiLevel];

            int oppCount = 1 + CountDirection(x, y, dir.Item1, dir.Item2, opponent)
                             + CountDirection(x, y, -dir.Item1, -dir.Item2, opponent);
            if (oppCount >= 5) score += blockWinWeight[aiLevel];
            else if (oppCount == 4) score += blockFourWeight[aiLevel];
            else if (oppCount == 3) score += blockThreeWeight[aiLevel];
            else if (oppCount == 2) score += blockTwoWeight[aiLevel];
        }
        return score;
    }

    bool CheckWin(int x, int y, int player)
    {
        int[][] directions = new int[][]
        {
            new int[]{1,0}, new int[]{0,1}, new int[]{1,1}, new int[]{1,-1}
        };
        foreach (var dir in directions)
        {
            int count = 1;
            count += CountDirection(x, y, dir[0], dir[1], player);
            count += CountDirection(x, y, -dir[0], -dir[1], player);
            if (count >= 5)
                return true;
        }
        return false;
    }

    int CountDirection(int x, int y, int dx, int dy, int player)
    {
        int count = 0;
        for (int step = 1; step < 5; step++)
        {
            int nx = x + dx * step;
            int ny = y + dy * step;
            if (nx < 0 || nx >= BoardSize || ny < 0 || ny >= BoardSize)
                break;
            if (board[nx, ny] == player)
                count++;
            else
                break;
        }
        return count;
    }

    void Restart()
    {
        board = new int[BoardSize, BoardSize];
        currentPlayer = 1;
        winner = 0;
        moveHistory.Clear();
        lastMoveX = null;
        lastMoveY = null;
        if (isHumanVsAI && currentPlayer == 2)
        {
            _ = AITurnAsync();
        }
    }

    void ResetScore()
    {
        blackScore = 0;
        whiteScore = 0;
    }

    void SetAILevel(int level)
    {
        aiLevel = level;
        Restart();
    }

    void ToggleMode()
    {
        isHumanVsAI = !isHumanVsAI;
        Restart();
    }

    // 悔棋功能
    void Undo()
    {
        if (moveHistory.Count == 0) return;

        if (isHumanVsAI)
        {
            // 人机模式下，悔棋撤销两步（AI和玩家各一步）
            for (int i = 0; i < 2 && moveHistory.Count > 0; i++)
            {
                var last = moveHistory[^1];
                Array.Copy(last.BoardSnapshot, board, board.Length);
                currentPlayer = last.CurrentPlayer;
                winner = last.Winner;
                moveHistory.RemoveAt(moveHistory.Count - 1);
            }
        }
        else
        {
            // 人人模式下，悔棋撤销一步
            var last = moveHistory[^1];
            Array.Copy(last.BoardSnapshot, board, board.Length);
            currentPlayer = last.CurrentPlayer;
            winner = last.Winner;
            moveHistory.RemoveAt(moveHistory.Count - 1);
        }
        if (moveHistory.Count > 0)
        {
            lastMoveX = moveHistory[^1].X;
            lastMoveY = moveHistory[^1].Y;
        }
        else
        {
            lastMoveX = null;
            lastMoveY = null;
        }
        StateHasChanged();
    }

    string GetCellBg(int x, int y)
    {
        return (x + y) % 2 == 0 ? "#f9d77e" : "#eac066";
    }
}
